Options -Indexes

DirectoryIndex index.php

<FilesMatch "(^\.|\.(sql|md|lock|json|dist|zip|bak|log)$|^(db_check|create_admin)\.php$)">
    Require all denied
</FilesMatch>

RedirectMatch 403 /(?:\.git|\.agents|\.codex|audit|config|database|release|storage|vendor)(?:/|$)

<FilesMatch "^\\.">
    Require all denied
</FilesMatch>
